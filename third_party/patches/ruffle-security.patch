+#[cfg(test)]
+mod security_update_tests {
+    use url::{Origin, Url};
+
+    #[test]
+    fn nested_blob_url_origin_returns_opaque_without_recursion() {
+        let nested = format!("{}https://example.com/", "blob:".repeat(10_000));
+        let parsed = Url::parse(&nested).expect("nested blob URL should parse");
+        assert!(matches!(parsed.origin(), Origin::Opaque(_)));
+    }
+}
