diff --git a/core/common/src/xml.rs b/core/common/src/xml.rs
index a3f8c2b..ba5db9e 100644
--- a/core/common/src/xml.rs
+++ b/core/common/src/xml.rs
@@ -3,6 +3,49 @@ use regress::Regex;
 use std::str::Utf8Error;
 use std::sync::LazyLock;
 
+/// Preserve Flash's whole-text unescaping across quick-xml's reference events.
+/// In particular, AVM2 must see `&&amp;` together rather than decode `&amp;` alone.
+#[derive(Default)]
+pub struct XmlEventBuffer<'a> {
+    pending: Option<Result<quick_xml::events::Event<'a>, quick_xml::Error>>,
+}
+
+impl<'a> XmlEventBuffer<'a> {
+    pub fn read_event(
+        &mut self,
+        mut read: impl FnMut() -> Result<quick_xml::events::Event<'a>, quick_xml::Error>,
+    ) -> Result<quick_xml::events::Event<'a>, quick_xml::Error> {
+        use quick_xml::events::{BytesText, Event};
+        let mut event = self.pending.take().unwrap_or_else(&mut read)?;
+        if !matches!(event, Event::Text(_) | Event::GeneralRef(_)) {
+            return Ok(event);
+        }
+        let mut text = Vec::new();
+        loop {
+            match event {
+                Event::Text(value) => text.extend_from_slice(&value),
+                Event::GeneralRef(value) => {
+                    text.push(b'&');
+                    text.extend_from_slice(&value);
+                    text.push(b';');
+                }
+                _ => unreachable!(),
+            }
+            match read() {
+                Ok(next @ (Event::Text(_) | Event::GeneralRef(_))) => event = next,
+                other => {
+                    self.pending = Some(other);
+                    break;
+                }
+            }
+        }
+        let text = String::from_utf8(text).map_err(|error| {
+            quick_xml::Error::Encoding(quick_xml::encoding::EncodingError::Utf8(error.utf8_error()))
+        })?;
+        Ok(Event::Text(BytesText::from_escaped(text)))
+    }
+}
+
 // Matches XML entities like &amp; or &#39; or &#x1F600;
 // We exclude both ';' and '&' from the middle to avoid matching across multiple
 // ampersands - e.g. in "& &thing;" we want to match only "&thing;", not "& &thing;"
@@ -56,6 +99,7 @@ fn custom_unescape(input: &[u8], entity_regex: &Regex) -> Result<String, Utf8Err
             Err(
                 XmlEscapeError::InvalidCharRef(_)
                 | XmlEscapeError::UnrecognizedEntity(_, _)
+                | XmlEscapeError::TooManyNestedEntities
                 | XmlEscapeError::UnterminatedEntity(_),
             ) => result.push_str(entity),
         }
@@ -67,3 +111,41 @@ fn custom_unescape(input: &[u8], entity_regex: &Regex) -> Result<String, Utf8Err
 
     Ok(result)
 }
+
+#[cfg(test)]
+mod security_update_tests {
+    use super::*;
+    use quick_xml::{Reader, NsReader, events::Event};
+
+    #[test]
+    fn reference_chunks_preserve_flash_unescaping_and_text_boundaries() {
+        let mut reader = Reader::from_str("<a>A &amp; B &&amp; &unknown; &#65; &</a>");
+        reader.config_mut().allow_dangling_amp = true;
+        let mut events = XmlEventBuffer::default();
+        assert!(matches!(events.read_event(|| reader.read_event()).unwrap(), Event::Start(_)));
+        let Event::Text(text) = events.read_event(|| reader.read_event()).unwrap() else { panic!("expected one text node") };
+        assert_eq!(avm1_unescape(&text).unwrap(), "A & B && &unknown; A &");
+        assert_eq!(avm2_unescape(&text).unwrap(), "A & B &&amp; &unknown; A &");
+        assert!(matches!(events.read_event(|| reader.read_event()).unwrap(), Event::End(_)));
+        assert!(matches!(events.read_event(|| reader.read_event()).unwrap(), Event::Eof));
+    }
+
+    #[test]
+    fn namespace_limit_rejects_excess_declarations() {
+        let mut xml = String::from("<a");
+        for i in 0..257 { xml.push_str(&format!(" xmlns:p{i}=\"urn:{i}\"")); }
+        xml.push_str("/>");
+        let mut reader = NsReader::from_str(&xml);
+        assert!(reader.read_event().is_err());
+    }
+
+    #[test]
+    fn namespace_resolution_survives_buffered_text() {
+        let mut reader = NsReader::from_str("<a>one&amp;two<p:b xmlns:p=\"urn:test\"/></a>");
+        let mut events = XmlEventBuffer::default();
+        assert!(matches!(events.read_event(|| reader.read_event()).unwrap(), Event::Start(_)));
+        assert!(matches!(events.read_event(|| reader.read_event()).unwrap(), Event::Text(_)));
+        let Event::Empty(start) = events.read_event(|| reader.read_event()).unwrap() else { panic!("expected child") };
+        assert_eq!(reader.resolver().resolve_element(start.name()).0, quick_xml::name::ResolveResult::Bound(quick_xml::name::Namespace(b"urn:test")));
+    }
+}
